# ESP32OT
# Copyright (c) 2026 Laxilef
# SPDX-License-Identifier: GPL-3.0-only
# https://github.com/Laxilef/ESP32OT
# Requires clang-format 22 or newer; verified with 23.1.1.
---
BasedOnStyle: LLVM
Language: Cpp
Standard: c++17

# Indent C++ scopes, continuations and preprocessor directives by two spaces.
UseTab: Never
IndentWidth: 2
TabWidth: 2
ContinuationIndentWidth: 2
ConstructorInitializerIndentWidth: 2
NamespaceIndentation: All
CompactNamespaces: false
AccessModifierOffset: -2
IndentAccessModifiers: false
IndentCaseLabels: true
IndentCaseBlocks: false
IndentPPDirectives: BeforeHash
PPIndentWidth: 2

# Keep braces attached and ordinary function/control-flow bodies multiline.
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Empty
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortLambdasOnASingleLine: None
AllowShortEnumsOnASingleLine: false

# Preserve deliberate line breaks and compact calls without imposing a width.
ColumnLimit: 0
AlignAfterOpenBracket: false
AlignOperands: DontAlign
BinPackArguments: false
BinPackParameters: OnePerLine
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
BreakAfterOpenBracketFunction: true
BreakBeforeCloseBracketFunction: true
BreakAfterOpenBracketBracedList: true
BreakBeforeCloseBracketBracedList: true
BreakBeforeBinaryOperators: NonAssignment
BreakBeforeTernaryOperators: true
BreakTemplateDeclarations: Yes
BreakConstructorInitializers: BeforeColon

PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false
SpaceBeforeParens: ControlStatements
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignTrailingComments:
  Kind: Leave

# Retain include order, explanatory comments and existing logical blank lines.
SortIncludes: Never
IncludeBlocks: Preserve
SortUsingDeclarations: Never
ReflowComments: Never
BreakStringLiterals: false
FixNamespaceComments: false
MaxEmptyLinesToKeep: 1
EmptyLineBeforeAccessModifier: Leave
EmptyLineAfterAccessModifier: Never
KeepEmptyLines:
  AtStartOfFile: false
  AtStartOfBlock: true
  AtEndOfFile: false
LineEnding: DeriveCRLF

# Recognize the ESP32 ISR attribute and avoid source-token transformations.
AttributeMacros:
  - IRAM_ATTR
SkipMacroDefinitionBody: true
QualifierAlignment: Leave
InsertBraces: false
RemoveBracesLLVM: false
RemoveParentheses: Leave
RemoveSemicolon: false
InsertTrailingCommas: None
